{
  "name": "c-error-helper",
  "displayName": "C语言报错翻译器",
  "description": "把 C/C++ 编译报错翻译成中文解释：错在哪、为什么、怎么改、正确写法。纯本地离线，秒解析。",
  "version": "0.1.1",
  "publisher": "xiaogaokunkun",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Education",
    "Linters"
  ],
  "keywords": [
    "c",
    "c++",
    "error",
    "报错翻译",
    "中文报错",
    "gcc",
    "dev-c++",
    "chinese",
    "beginner",
    "初学者",
    "offline",
    "intellisense"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaogaokunkun/c-error-helper.git"
  },
  "bugs": {
    "url": "https://github.com/xiaogaokunkun/c-error-helper/issues"
  },
  "homepage": "https://github.com/xiaogaokunkun/c-error-helper#readme",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "contributes": {},
  "scripts": {
    "compile": "tsc -p .",
    "test": "node test/run-tests.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.5"
  }
}
